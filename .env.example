# ───────── Core ─────────

DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=require"

NEXTAUTH_SECRET="your-super-secret-key-change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ───────── AI ─────────

GOOGLE_GENERATIVE_AI_API_KEYS="your-gemini-api-key-1,your-gemini-api-key-2"

GROQ_API_KEY="your-groq-api-key"
GROQ_CODE_REVIEW_MODEL="openai/gpt-oss-120b"
GEMINI_CODE_REVIEW_MODEL="gemini-3.8-flash"

OPENROUTER_API_KEYS="your-openrouter-api-key-1,your-openrouter-api-key-2"

# Optional providers
CEREBRAS_API_KEY="your-cerebras-api-key"
MISTRAL_API_KEY="your-mistral-api-key"
COHERE_API_KEY="your-cohere-api-key"
NVIDIA_API_KEY="your-nvidia-api-key"

# ───────── Infrastructure ─────────

REDIS_URL="redis://localhost:6379"

# ───────── GitHub App (code review webhooks) ─────────
# Least privilege: Contents read, Pull requests read, Checks write.
# Subscribe the app to pull_request events and point the webhook at
# {NEXT_PUBLIC_APP_URL}/api/integrations/github/webhook

GITHUB_APP_ID=""
GITHUB_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""
# Personal token fallback when an installation token cannot be minted.
GITHUB_TOKEN=""

MINIO_ENDPOINT="localhost"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="specforge"
