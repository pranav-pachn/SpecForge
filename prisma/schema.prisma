generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                   @id @default(cuid())
  email              String                   @unique
  name               String?
  passwordHash       String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  emailVerified      DateTime?
  image              String?
  accounts           Account[]
  approvalVotes      ApprovalVote[]
  auditLogs          AuditLog[]
  comments           Comment[]
  notifications      Notification[]
  notificationPrefs  NotificationPreference[]
  orgMemberships     OrgMember[]
  ownedOrganizations Organization[]           @relation("OrgOwner")
  projectMemberships ProjectMember[]
  sessions           Session[]
  teamMemberships    TeamMember[]
  workflows          Workflow[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  plan                 OrgPlan               @default(FREE)
  ownerId              String
  logoUrl              String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  approvalChains       ApprovalChain[]
  auditLogs            AuditLog[]
  flags                CapabilityFlag[]
  comments             Comment[]
  invitations          Invitation[]
  knowledgeNodes       KnowledgeNode[]
  metricRollups        MetricRollup[]
  notifications        Notification[]
  notificationChannels NotificationChannel[]
  members              OrgMember[]
  owner                User                  @relation("OrgOwner", fields: [ownerId], references: [id])
  policies             Policy[]
  projects             Project[]
  tasks                Task[]
  teams                Team[]
  templates            Template[]
  usageRecords         UsageRecord[]
  workflows            Workflow[]
}

model OrgMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole      @default(MEMBER)
  joinedAt       DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Team {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime       @default(now())
  metricRollups  MetricRollup[]
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        TeamMember[]
  workflows      Workflow[]
}

model TeamMember {
  teamId String
  userId String
  role   TeamRole @default(MEMBER)
  team   Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           OrgRole
  token          String       @unique @default(cuid())
  expiresAt      DateTime
  acceptedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model CapabilityFlag {
  id             String       @id @default(cuid())
  organizationId String
  flag           String
  enabled        Boolean      @default(false)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, flag])
}

model Project {
  id             String          @id @default(cuid())
  name           String
  description    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        ProjectMember[]
  workflows      Workflow[]
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(VIEWER)
  createdAt DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Policy {
  id             String       @id @default(cuid())
  organizationId String
  entityType     String
  trigger        String
  requiredRoles  String[]
  minApprovers   Int          @default(1)
  autoApprove    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Comment {
  id             String       @id @default(cuid())
  organizationId String
  entityType     String
  entityId       String
  userId         String
  content        String
  parentId       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         Comment?     @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Comment[]    @relation("CommentReplies")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
}

model Workflow {
  id                  String              @id @default(cuid())
  name                String
  status              WorkflowStatus      @default(DRAFT)
  projectId           String
  creatorId           String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  approvalPolicy      ApprovalPolicy      @default(HIGH_AND_CRITICAL)
  organizationId      String?
  teamId              String?
  agentCheckpoints    AgentCheckpoint[]
  agentExecutions     AgentExecution[]
  artifacts           Artifact[]
  driftAnalyses       DriftAnalysis[]
  engineeringMemories EngineeringMemory[]
  engineeringReviews  EngineeringReview[]
  knowledgeNodes      KnowledgeNode[]
  LearningExecution   LearningExecution[]
  events              StoredEvent[]
  tasks               Task[]
  validationReports   ValidationReport[]
  creator             User                @relation(fields: [creatorId], references: [id])
  organization        Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project             Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team                Team?               @relation(fields: [teamId], references: [id])
}

model Artifact {
  id         String            @id @default(cuid())
  workflowId String
  type       ArtifactType
  title      String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  workflow   Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  versions   ArtifactVersion[]
}

model ArtifactVersion {
  id                  String                  @id @default(cuid())
  artifactId          String
  version             Int
  content             String
  status              ArtifactVersionStatus   @default(DRAFT)
  createdAt           DateTime                @default(now())
  artifact            Artifact                @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  clarifications      ClarificationQuestion[]
  driftAsNew          DriftAnalysis[]         @relation("DriftNewVersion")
  driftAsOld          DriftAnalysis[]         @relation("DriftOldVersion")
  driftEvents         DriftEvent[]            @relation("SourceVersion")
  targetDriftEvents   DriftEvent[]
  engineeringMemories EngineeringMemory[]
  engineeringReviews  EngineeringReview[]
  executionPacks      ExecutionPack[]
  reviewChecks        ReviewCheck[]
  tasks               Task[]
  validationReports   ValidationReport[]
}

model ClarificationQuestion {
  id        String               @id @default(cuid())
  versionId String
  question  String
  category  String?
  status    ClarificationStatus  @default(OPEN)
  createdAt DateTime             @default(now())
  impact    Json?
  options   Json?
  rationale String?
  answer    ClarificationAnswer?
  version   ArtifactVersion      @relation(fields: [versionId], references: [id], onDelete: Cascade)
}

model ClarificationAnswer {
  id         String                @id @default(cuid())
  questionId String                @unique
  answer     String
  createdAt  DateTime              @default(now())
  question   ClarificationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Task {
  id                 String            @id @default(cuid())
  workflowId         String
  versionId          String
  title              String
  description        String?
  status             TaskStatus        @default(TODO)
  priority           Int?
  order              Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  acceptanceCriteria String?
  verificationNotes  String?
  complexity         String?
  requirements       String[]
  organizationId     String?
  executionPacks     ExecutionPack[]
  reviewFindings     ReviewFinding[]
  organization       Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  version            ArtifactVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  workflow           Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  dependencies       TaskDependency[]  @relation("DependentTasks")
  dependsOn          TaskDependency[]  @relation("TaskDependencies")
  validationIssues   ValidationIssue[]
}

model TaskDependency {
  id          String @id @default(cuid())
  taskId      String
  dependsOnId String
  dependsOn   Task   @relation("DependentTasks", fields: [dependsOnId], references: [id], onDelete: Cascade)
  task        Task   @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
}

model ExecutionPack {
  id        String          @id @default(cuid())
  versionId String
  toolName  ToolName
  content   String
  createdAt DateTime        @default(now())
  taskId    String?
  task      Task?           @relation(fields: [taskId], references: [id])
  version   ArtifactVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
}

model ReviewCheck {
  id          String          @id @default(cuid())
  versionId   String
  type        ReviewCheckType
  description String
  status      CheckStatus     @default(PENDING)
  createdAt   DateTime        @default(now())
  version     ArtifactVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
}

model DriftEvent {
  id              String           @id @default(cuid())
  versionId       String
  sourceVersionId String?
  entityType      DriftEntityType
  entityId        String
  description     String
  createdAt       DateTime         @default(now())
  resolvedAt      DateTime?
  resolvedBy      String?
  status          DriftEventStatus @default(OPEN)
  sourceVersion   ArtifactVersion? @relation("SourceVersion", fields: [sourceVersionId], references: [id])
  version         ArtifactVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
}

model ToolProfile {
  id        String   @id @default(cuid())
  name      String   @unique
  config    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventLog {
  id         String    @id @default(cuid())
  eventType  EventType
  workflowId String?
  userId     String?
  metadata   String?
  createdAt  DateTime  @default(now())
}

model EngineeringReview {
  id                String          @id @default(cuid())
  workflowId        String
  versionId         String
  overallScore      Int
  coverageScore     Int
  testingScore      Int
  securityScore     Int
  performanceScore  Int
  architectureScore Int
  deploymentScore   Int
  rollbackScore     Int
  status            String          @default("PENDING")
  coverageData      String?
  testingData       String?
  securityData      String?
  performanceData   String?
  architectureData  String?
  deploymentData    String?
  rollbackData      String?
  generatedAt       DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  version           ArtifactVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  workflow          Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  findings          ReviewFinding[]
}

model ReviewFinding {
  id          String            @id @default(cuid())
  reviewId    String
  category    String
  severity    String
  title       String
  description String
  resolved    Boolean           @default(false)
  taskId      String?
  review      EngineeringReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  task        Task?             @relation(fields: [taskId], references: [id])
}

model ValidationReport {
  id               String            @id @default(cuid())
  workflowId       String
  versionId        String
  overallScore     Int
  coverageScore    Int
  taskMappingScore Int
  acceptanceScore  Int
  executionScore   Int
  dependencyScore  Int
  duplicateScore   Int
  status           String            @default("PENDING")
  coverageData     String?
  taskMappingData  String?
  acceptanceData   String?
  executionData    String?
  dependencyData   String?
  duplicateData    String?
  generatedAt      DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  issues           ValidationIssue[]
  version          ArtifactVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  workflow         Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model ValidationIssue {
  id                  String           @id @default(cuid())
  reportId            String
  severity            String
  category            String
  title               String
  description         String
  linkedRequirementId String?
  linkedTaskId        String?
  recommendation      String?
  resolved            Boolean          @default(false)
  taskId              String?
  report              ValidationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  task                Task?            @relation(fields: [taskId], references: [id])
}

model DriftAnalysis {
  id           String          @id @default(cuid())
  workflowId   String
  oldVersionId String
  newVersionId String
  diffData     String
  impactData   String
  summary      String
  status       String          @default("DETECTED")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  newVersion   ArtifactVersion @relation("DriftNewVersion", fields: [newVersionId], references: [id], onDelete: Cascade)
  oldVersion   ArtifactVersion @relation("DriftOldVersion", fields: [oldVersionId], references: [id], onDelete: Cascade)
  workflow     Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model KnowledgeNode {
  id              String                  @id @default(cuid())
  workflowId      String
  type            String
  artifactId      String?
  version         Int                     @default(1)
  status          String                  @default("APPROVED")
  title           String
  content         String
  embedding       Unsupported("vector")?
  importanceScore Float                   @default(0.5)
  metadata        Json                    @default("{}")
  createdAt       DateTime                @default(now())
  organizationId  String?
  organization    Organization?           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow        Workflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  sourceRelations KnowledgeRelationship[] @relation("SourceNode")
  targetRelations KnowledgeRelationship[] @relation("TargetNode")

  @@index([workflowId])
  @@index([type])
}

model LearningPattern {
  id              String                   @id @default(cuid())
  fingerprint     String                   @unique
  type            String
  severity        String
  confidence      Float
  description     String
  evidence        Json
  detector        String
  detectorVersion String
  status          String                   @default("DETECTED")
  firstDetectedAt DateTime                 @default(now())
  lastDetectedAt  DateTime                 @default(now())
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  recommendations LearningRecommendation[]
}

model LearningRecommendation {
  id               String               @id @default(cuid())
  patternId        String
  type             String
  status           String               @default("PROPOSED")
  proposedChange   Json
  rationale        String
  expectedImpact   String
  confidence       Float
  evidence         Json
  generator        String
  generatorVersion String
  fingerprint      String               @unique
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  benchmarks       LearningBenchmark[]
  decision         LearningDecision?
  experiments      LearningExperiment[]
  pattern          LearningPattern      @relation(fields: [patternId], references: [id])

  @@index([patternId])
  @@index([status])
}

model LearningExperiment {
  id               String                 @id @default(cuid())
  recommendationId String
  status           String                 @default("PENDING")
  experimentType   String
  targetWorkflowId String?
  testExecutionId  String?
  controlMetrics   Json?
  candidateMetrics Json?
  comparison       Json?
  primaryMetric    String?
  result           String?
  error            String?
  fingerprint      String                 @unique
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  recommendation   LearningRecommendation @relation(fields: [recommendationId], references: [id])

  @@index([recommendationId])
  @@index([status])
}

model LearningBenchmark {
  id                String                 @id @default(cuid())
  recommendationId  String
  status            String                 @default("PENDING")
  datasetId         String
  datasetVersion    String
  runCount          Int
  targetRunCount    Int?
  controlMetrics    Json?
  candidateMetrics  Json?
  primaryMetric     String?
  statisticalResult Json?
  guardrailResult   Json?
  confidenceLevel   Float?
  result            String?
  error             String?
  fingerprint       String                 @unique
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  recommendation    LearningRecommendation @relation(fields: [recommendationId], references: [id])

  @@index([recommendationId])
  @@index([status])
}

model LearningDecision {
  id               String                 @id @default(cuid())
  recommendationId String                 @unique
  decision         String
  decisionSource   String
  policyVersion    String
  rationale        String
  reviewedBy       String?
  evidence         Json
  fingerprint      String                 @unique
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  adaptation       LearningAdaptation?
  recommendation   LearningRecommendation @relation(fields: [recommendationId], references: [id])

  @@index([decision])
}

model LearningAdaptation {
  id              String           @id @default(cuid())
  decisionId      String           @unique
  actionType      String
  targetKey       String
  status          String
  previousState   Json
  newState        Json
  previousVersion Int?
  newVersion      Int?
  fingerprint     String           @unique
  appliedAt       DateTime?
  revertedAt      DateTime?
  appliedBy       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  decision        LearningDecision @relation(fields: [decisionId], references: [id])

  @@index([status])
  @@index([targetKey])
}

model SystemConfig {
  key                   String   @id
  value                 Json
  version               Int      @default(1)
  updatedByAdaptationId String?
  updatedAt             DateTime @updatedAt
}

model EvaluationRun {
  id         String   @id @default(cuid())
  workflowId String
  overall    Float
  riskLevel  String
  createdAt  DateTime @default(now())

  @@index([workflowId])
}

model PromptVariant {
  id          String             @id @default(cuid())
  name        String
  evaluations PromptEvaluation[]
}

model PromptEvaluation {
  id               String        @id @default(cuid())
  workflowId       String
  variantId        String
  provider         String
  model            String
  promptTokens     Int
  completionTokens Int
  latencyMs        Int
  repairTriggered  Boolean       @default(false)
  repairAttempts   Int           @default(0)
  createdAt        DateTime      @default(now())
  variant          PromptVariant @relation(fields: [variantId], references: [id])

  @@index([workflowId])
}

model BenchmarkResult {
  id    String @id @default(cuid())
  score Float
}

model ProjectBaseline {
  id                 String   @id @default(cuid())
  projectId          String
  targetArtifactType String
  preferredProvider  String
  preferredModel     String
  preferredPromptId  String
  updatedAt          DateTime @updatedAt

  @@unique([projectId, targetArtifactType])
}

model LearningExecution {
  id              String    @id @default(cuid())
  executionId     String
  workflowId      String
  startedAt       DateTime
  completedAt     DateTime?
  success         Boolean
  confidence      Float?
  risk            String?
  totalDurationMs Int?
  repairCount     Int       @default(0)
  benchmarkScore  Float?
  stages          Json
  failures        Json
  prompts         Json
  source          Json
  schemaVersion   Int       @default(1)
  ingestedAt      DateTime  @default(now())
  workflow        Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([executionId, schemaVersion])
  @@index([workflowId])
  @@index([ingestedAt])
}

model KnowledgeRelationship {
  id           String        @id @default(cuid())
  sourceNodeId String
  targetNodeId String
  relationType String
  sourceNode   KnowledgeNode @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode   KnowledgeNode @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([sourceNodeId, targetNodeId, relationType])
}

model EngineeringMemory {
  id                String           @id @default(cuid())
  decisionId        String           @unique
  workflowId        String
  memoryType        MemoryType
  status            MemoryStatus     @default(ACTIVE)
  severity          MemorySeverity   @default(MEDIUM)
  title             String
  description       String
  reason            String
  sourceVersionId   String?
  createdBy         MemoryCreatedBy  @default(AI_DECISION)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  approvedAt        DateTime?
  approvedBy        String?
  confidence        Float?
  confidenceSources Json?
  consolidatedTitle String?
  lastRevisedAt     DateTime?
  rejectedReason    String?
  revisionCount     Int              @default(1)
  organizationId    String?
  sourceVersion     ArtifactVersion? @relation(fields: [sourceVersionId], references: [id])
  workflow          Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  revisions         MemoryRevision[]
}

model MemoryRevision {
  id          String            @id @default(cuid())
  memoryId    String
  revision    Int
  title       String
  description String
  reason      String
  oldContent  String?
  newContent  String?
  createdAt   DateTime          @default(now())
  memory      EngineeringMemory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
}

model MemoryRelationship {
  id           String   @id @default(cuid())
  sourceType   String
  sourceId     String
  targetType   String
  targetId     String
  relationType String
  createdAt    DateTime @default(now())

  @@unique([sourceType, sourceId, targetType, targetId, relationType])
}

model ApprovalChain {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  entityType     String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requests       ApprovalRequest[]
  steps          ApprovalStep[]
}

model ApprovalStep {
  id               String           @id @default(cuid())
  chainId          String
  stepOrder        Int
  parallelGroup    String
  requiredRole     String
  minApprovers     Int              @default(1)
  approvalStrategy ApprovalStrategy @default(FIXED_COUNT)
  chain            ApprovalChain    @relation(fields: [chainId], references: [id], onDelete: Cascade)
}

model ApprovalRequest {
  id          String         @id @default(cuid())
  chainId     String?
  entityId    String
  currentStep Int            @default(1)
  status      ApprovalStatus @default(PENDING)
  requestedBy String
  createdAt   DateTime       @default(now())
  resolvedAt  DateTime?
  chain       ApprovalChain? @relation(fields: [chainId], references: [id])
  votes       ApprovalVote[]
}

model ApprovalVote {
  id        String          @id @default(cuid())
  requestId String
  userId    String
  status    ApprovalStatus
  comment   String?
  step      Int
  createdAt DateTime        @default(now())
  request   ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, step, userId])
}

model NotificationChannel {
  id              String       @id @default(cuid())
  organizationId  String
  channelType     String
  config          Json
  encryptedFields String[]
  enabled         Boolean      @default(true)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Notification {
  id               String                 @id @default(cuid())
  userId           String
  orgId            String
  event            String
  title            String
  body             String?
  entityId         String?
  channel          String                 @default("IN_APP")
  read             Boolean                @default(false)
  createdAt        DateTime               @default(now())
  organization     Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryAttempts NotificationDelivery[]
}

model NotificationDelivery {
  id             String       @id @default(cuid())
  notificationId String
  channelType    String
  status         String
  error          String?
  attemptedAt    DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id          String  @id @default(cuid())
  userId      String
  channelType String
  enabled     Boolean @default(true)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channelType])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  eventType      String
  entityType     String
  entityId       String?
  correlationId  String
  causationId    String?
  source         String       @default("SYSTEM")
  payload        Json
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([createdAt])
  @@index([entityType])
  @@index([entityId])
  @@index([userId])
  @@index([correlationId])
}

model MetricRollup {
  id              String       @id @default(cuid())
  organizationId  String
  teamId          String?
  period          RollupPeriod
  date            DateTime
  cycleTime       Float?
  leadTime        Float?
  driftResolution Float?
  reviewScore     Int?
  coverage        Int?
  confidence      Int?
  approvalHealth  Int?
  maturityScore   Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team            Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([organizationId, teamId, period, date])
}

model UsageRecord {
  id             String       @id @default(cuid())
  organizationId String
  metric         String
  count          Int          @default(0)
  periodStart    DateTime
  periodEnd      DateTime
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metric, periodStart])
  @@index([organizationId])
}

model Template {
  id             String        @id @default(cuid())
  organizationId String?
  name           String
  description    String?
  version        Int           @default(1)
  config         Json
  isDeprecated   Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name, version])
  @@index([organizationId])
}

model StoredEvent {
  id            String    @id @default(cuid())
  type          String
  source        String
  occurredAt    DateTime
  workflowId    String?
  sequence      Int
  userId        String?
  correlationId String?
  causationId   String?
  status        String
  payload       Json
  workflow      Workflow? @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, sequence])
  @@index([workflowId, occurredAt])
  @@index([type])
  @@index([correlationId])
}

model AgentCheckpoint {
  id              String   @id @default(cuid())
  workflowId      String
  completedAgents String[]
  version         Int      @default(1)
  artifacts       Json
  snapshotAt      DateTime @default(now())
  workflow        Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

model AgentExecution {
  id          String               @id @default(cuid())
  workflowId  String
  agentId     String
  status      AgentExecutionStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?
  retries     Int                  @default(0)
  progress    Int                  @default(0)
  durationMs  Int?
  error       String?
  workflow    Workflow             @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

